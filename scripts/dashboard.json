{
  "dashboard": {
    "title": "Zenith Performance & SLO Dashboard",
    "tags": ["zenith", "slo", "performance"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Check Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(zenith_request_duration_seconds_bucket{operation=\"check\"}[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(zenith_request_duration_seconds_bucket{operation=\"check\"}[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(zenith_request_duration_seconds_bucket{operation=\"check\"}[5m]))",
            "legendFormat": "p99"
          },
          {
            "expr": "0.05",
            "legendFormat": "SLO Target (50ms)",
            "refId": "slo"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          }
        ]
      },
      {
        "id": 2,
        "title": "Cache Hit Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(zenith_cache_hits_total[5m]) / (rate(zenith_cache_hits_total[5m]) + rate(zenith_cache_misses_total[5m])) * 100",
            "legendFormat": "Hit Rate %"
          },
          {
            "expr": "70",
            "legendFormat": "SLO Target (70%)",
            "refId": "slo"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "max": 100,
            "min": 0
          }
        ]
      },
      {
        "id": 3,
        "title": "SLO: Check Latency P99",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "zenith_slo_check_latency_p99_seconds",
            "legendFormat": "P99 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.05, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Error Budget Remaining",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "zenith_slo_error_budget_remaining_percent",
            "legendFormat": "Error Budget %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 20, "color": "yellow"},
                {"value": 80, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Availability",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "zenith_slo_availability_percentage",
            "legendFormat": "Availability %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 99.0, "color": "yellow"},
                {"value": 99.9, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
        "targets": [
          {
            "expr": "zenith_slo_cache_hit_rate_percent",
            "legendFormat": "Hit Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 50, "color": "yellow"},
                {"value": 70, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Expansion Depth Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(zenith_expansion_depth_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(zenith_expansion_depth_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(zenith_expansion_depth_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Depth"
          }
        ]
      },
      {
        "id": 8,
        "title": "Circuit Breaker State",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "zenith_circuit_breaker_state",
            "legendFormat": "{{operation}}"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "State (0=closed, 1=open, 2=half_open)"
          }
        ]
      },
      {
        "id": 9,
        "title": "Request Rate by Operation",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(zenith_requests_total[5m])",
            "legendFormat": "{{operation}} - {{status}}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 10,
        "title": "Database Connection Pool",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "zenith_active_connections",
            "legendFormat": "Active Connections"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Connections"
          }
        ]
      },
      {
        "id": 11,
        "title": "Batch Check Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "rate(zenith_batch_check_size_bucket[5m])",
            "legendFormat": "Batch Size Distribution"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Count"
          }
        ]
      },
      {
        "id": 12,
        "title": "Stale Cache Served",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "rate(zenith_stale_cache_served_total[5m])",
            "legendFormat": "{{operation}}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Stale Cache Served/sec"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "name": "SLO Violation",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "zenith_slo_check_latency_p99_seconds > 0.05",
          "titleFormat": "SLO Violation",
          "tags": ["slo", "violation"]
        }
      ]
    },
    "alerting": {
      "alertRuleTags": {}
    }
  }
}

